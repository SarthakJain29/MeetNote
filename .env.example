# All optional. With no keys the app runs in mock mode (local heuristic analysis).
# AI_PROVIDER: auto | gemini | groq | mock   (auto = first configured key, else mock)
AI_PROVIDER=auto
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
